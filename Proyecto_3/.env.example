# =============================
# Proyecto_1 - Environment template
# =============================
# Copy this file to .env before running Docker Compose:
#   cp .env.example .env

# Airflow user/group mapping for mounted volumes.
# On Linux, set this to your UID (e.g. id -u).
# On Windows/macOS, 50000 works in most cases.
AIRFLOW_UID=50000

# IMPORTANT:
# This path is resolved from compose/airflow.yml (included compose file context).
# Use ../Airflow so mounts point to Proyecto_1/Airflow and not Proyecto_1/compose/Airflow.
AIRFLOW_PROJ_DIR=../Airflow